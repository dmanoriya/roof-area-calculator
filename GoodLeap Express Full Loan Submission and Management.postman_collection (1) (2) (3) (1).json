		{
			"name": "Submission",
			"item": [
				{
					"name": "Submit Loan Application",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const address = pm.environment.get('devapi-appaddress');\r",
									"const [numStr,...rest] = address.split(' ');\r",
									"const number = Number.parseInt(numStr);\r",
									"const newAddress = [ number+1, ...rest].join(' ');\r",
									"\r",
									"pm.environment.set('devapi-appaddress', newAddress);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"const parsedResponse = JSON.parse(responseBody);",
									"const loanId = parsedResponse.id;",
									"pm.environment.set('devapi-currentloanid', loanId);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\r\n    \"applicant\": {\r\n        \"firstName\": \"Test\",\r\n        \"lastName\": \"Borrower\",\r\n        \"address\": {\r\n            \"street\": \"{{devapi-appaddress}}\",\r\n            \"city\": \"Rocklin\",\r\n            \"state\": \"CA\",\r\n            \"zip\": \"95765\"\r\n        },\r\n        \"ssn\": \"0101\",\r\n        \"email\": \"{{devapi-borroweremail}}\",\r\n        \"annualIncome\": {\r\n            \"type\": \"USD\",\r\n            \"value\": 500000\r\n        },\r\n        \"citizenshipStatus\": \"US_CITIZEN\",\r\n        \"dob\": \"1970-01-01\",\r\n        \"electronicConsent\": true,\r\n        \"employer\": \"GoodLeap\",\r\n        \"employmentStatus\": \"EMPLOYED\",\r\n        \"employmentDuration\": 25,\r\n        \"homeOccupancy\": \"PRIMARY\",\r\n        \"homeOwnership\": \"OWNED_WITH_MORTGAGE\",\r\n        \"occupation\": \"Developer\",\r\n        \"primaryPhoneNumber\": {\r\n            \"value\": \"8013623378\",\r\n            \"type\": \"MOBILE\"\r\n        },\r\n        \"spokenLanguage\": \"ENGLISH\"\r\n    },\r\n    \"categoryId\": \"{{devapi-icatid}}\",\r\n    \"submittingUser\": {\r\n        \"firstName\": \"Submitting\",\r\n        \"lastName\": \"User\",\r\n        \"email\": \"{{devapi-submittinguser}}\"\r\n    },\r\n    \"offerId\": \"{{devapi-offerid1}}\",\r\n    \"amount\": {\r\n        \"value\": 20485.55,\r\n        \"type\": \"USD\"\r\n    },\r\n    \"applicantSignature\": \"{{devapi-signaturedata}}\",\r\n    \"subjectProperty\": {\r\n        \"address\": {\r\n            \"street\": \"{{devapi-appaddress}}\",\r\n            \"city\": \"Rocklin\",\r\n            \"state\": \"CA\",\r\n            \"zip\": \"95765\"\r\n        },\r\n        \"mortgageTotalBalances\": {\r\n            \"type\": \"USD\",\r\n            \"value\": \"200000\"\r\n        },\r\n        \"mortgageTotalPayments\": {\r\n            \"type\": \"USD\",\r\n            \"value\": \"1250\"\r\n        },\r\n        \"isMobileOrManufacturedHome\": false\r\n    },\r\n    \"referenceNumber\": \"{{devapi-referencenumber}}\",\r\n    \"disclosureToken\": \"{{devapi-disclosuretoken}}\",\r\n    \"enrollments\": [\r\n        \"AUTOPAY\"\r\n    ]\r\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
